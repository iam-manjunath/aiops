# ----------------------------------------
# App Runtime
# ----------------------------------------
AIOPS_ENVIRONMENT=local
AIOPS_EXECUTION_MODE=mock

# ----------------------------------------
# State Backend (json | postgres)
# ----------------------------------------
AIOPS_STATE_BACKEND=json
AIOPS_STATE_FILE=.data/aiops-state.json
AIOPS_POSTGRES_DSN=
AIOPS_POSTGRES_SCHEMA=aiops

# ----------------------------------------
# Remediation Safety
# ----------------------------------------
AIOPS_REMEDIATION_ALLOWLIST=restart_vm,resize_vmss,run_automation_webhook,adjust_autoscale_rule,create_ticket,manual_action_required
AIOPS_DESTRUCTIVE_ACTION_ALLOWLIST=
AIOPS_AUTOMATION_WEBHOOK_URL=

# ----------------------------------------
# Azure Subscriptions / Log Analytics
# ----------------------------------------
# Optional:
# - If AIOPS_AZURE_SUBSCRIPTION_IDS is empty and live integrations are enabled,
#   the app auto-discovers subscriptions from the current Azure identity.
# - If workspace id/map is empty, Log Analytics query can auto-select the first
#   workspace discovered in a subscription when live integrations are enabled.
AIOPS_AZURE_SUBSCRIPTION_IDS=
AIOPS_LOG_ANALYTICS_WORKSPACE_ID=
AIOPS_LOG_ANALYTICS_WORKSPACE_MAP=
AIOPS_LOG_QUERY_TIMESPAN_MINUTES=60
AIOPS_ENABLE_LIVE_AZURE_INTEGRATIONS=false

# ----------------------------------------
# Microsoft Entra Authentication
# ----------------------------------------
AIOPS_AUTH_ENABLED=false
AIOPS_AUTH_TENANT_ID=organizations
AIOPS_AUTH_CLIENT_ID=
AIOPS_AUTH_CLIENT_SECRET=
AIOPS_AUTH_SESSION_SECRET=change-me-to-a-long-random-secret
AIOPS_AUTH_SCOPES=openid profile email offline_access
AIOPS_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/
AIOPS_AUTH_ENABLE_OBO=true
AIOPS_AUTH_STRICT_OBO=false
AIOPS_AUTH_OBO_ARM_SCOPE=https://management.azure.com/user_impersonation
AIOPS_AUTH_OBO_LOG_ANALYTICS_SCOPE=https://api.loganalytics.io/Data.Read

# ----------------------------------------
# Azure OpenAI
# ----------------------------------------
AIOPS_AZURE_OPENAI_ENDPOINT=
AIOPS_AZURE_OPENAI_DEPLOYMENT=
AIOPS_AZURE_OPENAI_API_VERSION=v1
AIOPS_AZURE_OPENAI_API_KEY=
AIOPS_AZURE_OPENAI_AUTH_MODE=api_key

# ----------------------------------------
# Azure AI Search (RAG)
# ----------------------------------------
AIOPS_AI_SEARCH_ENDPOINT=
AIOPS_AI_SEARCH_INDEX=
AIOPS_AI_SEARCH_API_KEY=
AIOPS_AI_SEARCH_AUTH_MODE=api_key
AIOPS_KNOWLEDGE_SOURCE_PATHS=docs
AIOPS_KNOWLEDGE_FILE_EXTENSIONS=.md,.txt,.rst
AIOPS_KNOWLEDGE_MAX_FILE_SIZE_KB=512
